function exportSettings() {
    fetch(`${CONFIG.API_BASE_URL}/api/settings/export`)
        .then(response => response.blob())
        .then(blob => {
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `dish_chat_settings_${new Date().toISOString().split('T')[0]}.json`;
            document.body.appendChild(a);
            a.click();
            window.URL.revokeObjectURL(url);
            document.body.removeChild(a);
            
            showSettingsStatus('success', 'Settings exported successfully');
        })
        .catch(error => {
            console.error('Export error:', error);
            showSettingsStatus('error', 'Failed to export settings');
        });
}

function importSettings(event) {
    const file = event.target.files[0];
    if (!file) return;
    
    const reader = new FileReader();
    reader.onload = (e) => {
        try {
            const data = JSON.parse(e.target.result);
            
            fetch(`${CONFIG.API_BASE_URL}/api/settings/import`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(result => {
                if (result.success && result.success.length > 0) {
                    showSettingsStatus('success', `Imported ${result.success.length} settings`);
                    loadAllSettings();
                }
                if (result.failed && result.failed.length > 0) {
                    showSettingsStatus('warning', `Failed to import ${result.failed.length} settings`);
                }
            });
        } catch (err) {
            showSettingsStatus('error', 'Invalid settings file');
        }
    };
    reader.readAsText(file);
    
    // Reset input
    event.target.value = '';
}

function filterSettings() {
    const search = document.getElementById('settings-search')?.value.toLowerCase() || '';
    const fields = document.querySelectorAll('.setting-field');
    
    fields.forEach(field => {
        const key = field.getAttribute('data-key')?.toLowerCase() || '';
        const description = field.querySelector('.setting-description')?.textContent.toLowerCase() || '';
        
        if (key.includes(search) || description.includes(search)) {
            field.style.display = '';
        } else {
            field.style.display = 'none';
        }
    });
}

function showSettingsStatus(type, message) {
    const status = document.getElementById('settings-status');
    if (!status) return;
    
    status.className = `settings-status ${type}`;
    status.innerHTML = `<i class="fas fa-${type === 'success' ? 'check' : 'exclamation'}-circle"></i> ${message}`;
    status.style.display = 'block';
    
    setTimeout(() => {
        status.style.display = 'none';
    }, 3000);
}

