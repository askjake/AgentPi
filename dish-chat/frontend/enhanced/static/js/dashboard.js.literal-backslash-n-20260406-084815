async function updateToolRankings(stats) {
    const container = document.querySelector(".tool-ranking");
    if (!container) return;
    
    try {
        // Fetch real tool usage data from backend
        const response = await fetch(CONFIG.API_BASE_URL + "/api/analytics/tools");
        if (!response.ok) throw new Error("Failed to fetch tool data");
        const toolData = await response.json();
        
        // If no data, show message
        if (!toolData.data || toolData.data.length === 0) {
            container.innerHTML = `
                <div style="text-align: center; padding: 40px; color: #718096;">
                    <i class="fas fa-chart-bar" style="font-size: 48px; margin-bottom: 15px; opacity: 0.5;"></i>
                    <p>No tool usage data yet</p>
                    <p style="font-size: 14px;">Tool statistics will appear as you use the system</p>
                </div>
            `;
            return;
        }
        
        // Calculate percentages relative to max
        const maxCount = Math.max(...toolData.data.map(t => t.count));
        const rankings = toolData.data.map(tool => ({
            name: tool.tool_name,
            count: tool.count,
            percentage: maxCount > 0 ? Math.round((tool.count / maxCount) * 100) : 0
        }));
        
        container.innerHTML = rankings.map((tool, index) => {
            const colors = ["#4299e1", "#48bb78", "#ed8936", "#9f7aea", "#f6ad55", "#fc8181", "#f6ad55"];
            const color = colors[index % colors.length];
            
            return `
                <div class="rank-item">
                    <span class="rank" style="color: ${color};">#${index + 1}</span>
                    <span class="tool-name">${tool.name}</span>
                    <div class="usage-bar" style="width: ${tool.percentage}%; background: ${color};"></div>
                    <span class="usage-count">${tool.count.toLocaleString()}</span>
                </div>
            `;
        }).join("");
    } catch (error) {
        console.error("Error loading tool rankings:", error);
        container.innerHTML = `
            <div style="text-align: center; padding: 20px; color: #e53e3e;">
                <p>Failed to load tool rankings</p>
                <button class="btn-primary" onclick="initAnalytics()" style="margin-top: 10px;">
                    <i class="fas fa-redo"></i> Retry
                </button>
            </div>
        `;
    }
}

