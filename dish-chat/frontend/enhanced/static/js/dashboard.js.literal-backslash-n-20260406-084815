function displaySettingsTab(tab) {
    const container = document.getElementById('settings-content');
    if (!container) return;
    
    let html = '';
    
    const tabMap = {
        'backend': 'BACKEND_CONFIGURATION',
        'frontend': 'FRONTEND_CONFIGURATION',
        'custom-tools': 'CUSTOM_TOOLS'
    };
    
    const sectionName = tabMap[tab];
    if (!sectionName || !settingsData[sectionName]) {
        container.innerHTML = '<p>No settings available for this section.</p>';
        return;
    }
    
    const section = settingsData[sectionName];
    
    for (const [categoryName, category] of Object.entries(section)) {
        html += `
            <div class="settings-category">
                <h3>${categoryName}</h3>
                <div class="settings-grid">
        `;
        
        for (const [key, config] of Object.entries(category)) {
            html += createSettingField(key, config);
        }
        
        html += `
                </div>
            </div>
        `;
    }
    
    container.innerHTML = html;
    
    // Attach event listeners
    container.querySelectorAll('.setting-input').forEach(input => {
        input.addEventListener('change', (e) => {
            const key = e.target.getAttribute('data-key');
            const type = e.target.getAttribute('data-type');
            let value = e.target.value;
            
            if (type === 'boolean') {
                value = e.target.checked;
            } else if (type === 'integer') {
                value = parseInt(value);
            }
            
            settingsModified[key] = value;
            markModified();
        });
    });
}

function createSettingField(key, config) {
    const {value, description, type, user_editable, sensitive, min, max, options} = config;
    
    if (!user_editable) {
        return `
            <div class="setting-field disabled">
                <label>
                    <i class="fas fa-lock"></i> ${key}
                    <span class="setting-description">${description} (System-only)</span>
                </label>
                <input type="text" value="${sensitive ? '********' : value}" disabled>
            </div>
        `;
    }
    
    let inputHtml = '';
    
    if (type === 'boolean') {
        inputHtml = `
            <label class="switch">
                <input type="checkbox" class="setting-input" data-key="${key}" data-type="${type}" 
                       ${value ? 'checked' : ''}>
                <span class="slider"></span>
            </label>
        `;
    } else if (type === 'select') {
        inputHtml = `
            <select class="setting-input" data-key="${key}" data-type="${type}">
                ${options.map(opt => `<option value="${opt}" ${opt === value ? 'selected' : ''}>${opt}</option>`).join('')}
            </select>
        `;
    } else if (type === 'integer') {
        inputHtml = `
            <input type="number" class="setting-input" data-key="${key}" data-type="${type}" 
                   value="${value}" min="${min || ''}" max="${max || ''}"
                   style="width: 100%; padding: 8px; border: 1px solid #cbd5e0; border-radius: 4px;">
            ${min !== undefined || max !== undefined ? `<small style="color: #718096;">Range: ${min || 'n/a'} - ${max || 'n/a'}</small>` : ''}
        `;
    } else if (type === 'password') {
        inputHtml = `
            <input type="password" class="setting-input" data-key="${key}" data-type="${type}" 
                   value="${value}" placeholder="Enter ${sensitive ? 'sensitive ' : ''}value"
                   style="width: 100%; padding: 8px; border: 1px solid #cbd5e0; border-radius: 4px;">
        `;
    } else {
        inputHtml = `
            <input type="text" class="setting-input" data-key="${key}" data-type="${type}" 
                   value="${value}"
                   style="width: 100%; padding: 8px; border: 1px solid #cbd5e0; border-radius: 4px;">
        `;
    }
    
    return `
        <div class="setting-field" data-key="${key}">
            <label>
                ${key}
                <span class="setting-description">${description}</span>
            </label>
            ${inputHtml}
        </div>
    `;
}

function markModified() {
    const saveBtn = document.getElementById('save-settings');
    if (saveBtn && Object.keys(settingsModified).length > 0) {
        saveBtn.style.background = '#48bb78';
        saveBtn.innerHTML = '<i class="fas fa-save"></i> Save Changes (' + Object.keys(settingsModified).length + ')';
    }
}

function saveAllSettings() {
    if (Object.keys(settingsModified).length === 0) {
        alert('No changes to save');
        return;
    }
    
    const saveBtn = document.getElementById('save-settings');
    saveBtn.disabled = true;
    saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
    
    fetch(`${CONFIG.API_BASE_URL}/api/settings/bulk`, {
        method: 'PUT',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({settings: settingsModified})
    })
    .then(response => response.json())
    .then(data => {
        console.log('Settings saved:', data);
        
        if (data.success && data.success.length > 0) {
            showSettingsStatus('success', `Saved ${data.success.length} settings`);
            settingsModified = {};
            saveBtn.style.background = '';
            saveBtn.innerHTML = '<i class="fas fa-save"></i> Save All Changes';
            
            // Reload settings
            loadAllSettings();
        }
        
        if (data.failed && data.failed.length > 0) {
            showSettingsStatus('error', `Failed to save ${data.failed.length} settings`);
        }
    })
    .catch(error => {
        console.error('Error saving settings:', error);
